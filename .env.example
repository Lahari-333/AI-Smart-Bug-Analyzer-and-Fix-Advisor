# AI Smart Bug Analyzer & Fix Advisor - Environment Configuration Template
# Copy this file to .env for local overrides. Never commit .env with secrets.

# Application Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Vector Database & Model Configuration
CHROMA_PERSIST_DIR=./chroma_db
LOCAL_MODEL_DIR=./local_ai_model

# Knowledge Base & Ingestion Settings
COLLECTION_NAME=intelligent_bug_diagnosis_memory
MAX_LOG_CHUNK_COUNT=150
SIMILARITY_THRESHOLD=0.85
